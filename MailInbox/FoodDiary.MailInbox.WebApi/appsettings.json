{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=fooddiary_mailinbox;Username=postgres"
  },
  "MailInboxRuntimeDatabase": {
    "RoleName": "mailinbox_runtime"
  },
  "MailInboxSmtp": {
    "Enabled": true,
    "ServerName": "mail.fooddiary.club",
    "ListenAddress": "0.0.0.0",
    "Port": 2525,
    "CertificatePath": "/etc/letsencrypt/live/mail.fooddiary.club/fullchain.pem",
    "PrivateKeyPath": "/etc/letsencrypt/live/mail.fooddiary.club/privkey.pem",
    "MaxMessageSizeBytes": 10485760,
    "MaxConcurrentConnections": 32,
    "MaxConcurrentConnectionsPerIp": 4,
    "MaxConcurrentMessageProcessing": 4,
    "ProcessingQueueTimeout": "00:00:10",
    "SessionTimeout": "00:02:00",
    "MaxMessagesPerSession": 10,
    "MaxMessagesPerIpPerHour": 100,
    "MaxMessagesPerSenderPerHour": 20,
    "MaxRawBytesPerIpPerHour": 67108864,
    "MaxTrackedRateLimitKeys": 10000,
    "MaxRecipientsPerMessage": 4,
    "MaxMimeParts": 100,
    "MaxMimeDepth": 20,
    "MaxExtractedBodyCharacters": 1000000,
    "AllowedRecipients": [
      "admin@fooddiary.club",
      "dmarc@fooddiary.club",
      "feedback@fooddiary.club",
      "support@fooddiary.club"
    ],
    "TrustedRelayNetworks": [],
    "AllowUntrustedSources": true
  },
  "MailInboxStorage": {
    "MaxMessagesPerDay": 5000,
    "MaxRawBytesPerDay": 536870912,
    "MaxUntrustedMessagesPerDay": 4000,
    "MaxUntrustedRawBytesPerDay": 402653184,
    "DeduplicationWindow": "1.00:00:00",
    "ContentRetention": "30.00:00:00",
    "MetadataRetention": "365.00:00:00",
    "CleanupInterval": "06:00:00",
    "CleanupBatchSize": 500,
    "MaxConcurrentMessageDetailReads": 2
  },
  "MailInboxHttp": {
    "MetadataApiKey": "",
    "ContentApiKey": "",
    "StateApiKey": "",
    "MaxConcurrentMessageDetailRequests": 2,
    "MessageDetailQueueTimeout": "00:00:05",
    "MessageDetailExecutionTimeout": "00:00:15"
  },
  "OpenTelemetry": {
    "Otlp": {
      "Endpoint": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
