server {
    listen 80;
    server_name techradar.fooddiary.club;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/fooddiary.club;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }

    error_log /var/log/nginx/fooddiary.techradar.error.log;
    access_log /var/log/nginx/fooddiary.techradar.access.log fooddiary_privacy;
}

server {
    listen 443 ssl;
    http2 on;
    server_name techradar.fooddiary.club;

    ssl_certificate /etc/letsencrypt/live/fooddiary.club/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fooddiary.club/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location / {
        proxy_pass http://127.0.0.1:4210;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    error_log /var/log/nginx/fooddiary.techradar.error.log;
    access_log /var/log/nginx/fooddiary.techradar.access.log fooddiary_privacy;
}
