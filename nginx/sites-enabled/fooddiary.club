server {
    listen 443 ssl;
    http2 on;
    server_name www.fooddiary.club;
    ssl_certificate /etc/letsencrypt/live/public.fooddiary.club/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/public.fooddiary.club/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    return 301 https://fooddiary.club$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name xn--b1adbcbrouc8l.xn--p1ai www.xn--b1adbcbrouc8l.xn--p1ai;
    ssl_certificate /etc/letsencrypt/live/public.fooddiary.club/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/public.fooddiary.club/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    return 410;

    error_log /var/log/nginx/fooddiary.disabled-idn.error.log;
    access_log /var/log/nginx/fooddiary.disabled-idn.access.log fooddiary_privacy;
}

# Russian IDN disabled. Restore this block when www.дневникеды.рф should redirect again.
# server {
#     listen 443 ssl;
#     http2 on;
#     server_name www.xn--b1adbcbrouc8l.xn--p1ai;
#     ssl_certificate /etc/letsencrypt/live/public.fooddiary.club/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/public.fooddiary.club/privkey.pem;
#
#     ssl_protocols TLSv1.2 TLSv1.3;
#     ssl_ciphers HIGH:!aNULL:!MD5;
#     ssl_prefer_server_ciphers on;
#
#     return 301 https://xn--b1adbcbrouc8l.xn--p1ai$request_uri;
# }

server {
    listen 443 ssl;
    listen 443 quic;
    http2 on;
    server_name fooddiary.club;
    # Russian IDN disabled. Restore when дневникеды.рф should serve traffic again:
    # server_name fooddiary.club xn--b1adbcbrouc8l.xn--p1ai;
    ssl_certificate /etc/letsencrypt/live/public.fooddiary.club/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/public.fooddiary.club/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://cdn.paddle.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-src https://accounts.google.com https://*.paddle.com; worker-src 'self' blob:; manifest-src 'self'" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Alt-Svc 'h3=":443"; ma=86400' always;
    add_header_inherit merge;

    root /var/www/fooddiary.club;
    index index.html;

    # Russian IDN prerender disabled.
    # set $seo_prerender_root "";
    # if ($host ~* ^(xn--b1adbcbrouc8l\.xn--p1ai|www\.xn--b1adbcbrouc8l\.xn--p1ai)$) {
    #     set $seo_prerender_root "/__ru";
    # }

    location ^~ /__ru/ {
        internal;
        try_files $uri =404;
    }

    location = /sitemap.xml {
        # Russian IDN sitemap disabled.
        # if ($host ~* ^(xn--b1adbcbrouc8l\.xn--p1ai|www\.xn--b1adbcbrouc8l\.xn--p1ai)$) {
        #     rewrite ^ /sitemap-ru.xml break;
        # }

        try_files $uri =404;
    }

    location = /robots.txt {
        # Russian IDN robots disabled.
        # if ($host ~* ^(xn--b1adbcbrouc8l\.xn--p1ai|www\.xn--b1adbcbrouc8l\.xn--p1ai)$) {
        #     rewrite ^ /robots-ru.txt break;
        # }

        try_files $uri =404;
    }

    location = /index.html {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
        try_files $uri =404;
    }

    location = /index.csr.html {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
        try_files $uri =404;
    }

    location = /ngsw.json {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
        try_files $uri =404;
    }

    location = /ngsw-worker.js {
        expires -1;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location = /safety-worker.js {
        expires -1;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location = /worker-basic.min.js {
        expires -1;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        # Russian IDN prerender disabled.
        # try_files $seo_prerender_root$uri/index.html $seo_prerender_root$uri $uri/index.html $uri $uri/ /index.html;
        try_files $uri/index.html $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $server_name;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /hubs/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $server_name;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    error_log /var/log/nginx/fooddiary.error.log;
    access_log /var/log/nginx/fooddiary.access.log fooddiary_privacy;
}

server {
    if ($host = admin.fooddiary.club) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    server_name admin.fooddiary.club;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/admin.fooddiary.club;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }

    error_log /var/log/nginx/fooddiary.admin.error.log;
    access_log /var/log/nginx/fooddiary.admin.access.log fooddiary_privacy;
}

server {
    listen 443 ssl;
    http2 on;
    server_name admin.fooddiary.club;
    ssl_certificate /etc/letsencrypt/live/fooddiary.club/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fooddiary.club/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://fooddiary.club; worker-src 'self' blob:; manifest-src 'self'" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header_inherit merge;

    location = /index.html {
        root /var/www/admin.fooddiary.club;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
        try_files $uri =404;
    }

    location /assets/ {
        root /var/www/admin.fooddiary.club;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$ {
        root /var/www/admin.fooddiary.club;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        root /var/www/admin.fooddiary.club;
        index index.html;
        try_files $uri /index.html;
    }

    error_log /var/log/nginx/fooddiary.admin.error.log;
    access_log /var/log/nginx/fooddiary.admin.access.log fooddiary_privacy;
}
