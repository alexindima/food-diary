  "panels": [
    {
      "id": 1,
      "title": "Как читать дашборд",
      "type": "text",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**$module** · Длительность включает ожидание БД, внешних API, валидацию и транзакцию; это не расход CPU. `failure` — возвращённый ошибочный Result, `exception` — исключение, `cancelled` — отмена переданным токеном. Вложенные операции учитываются отдельно. Подробные SQL/HTTP-трассировки не хранятся в текущем production Collector."
      }
    },
    {
      "id": 2,
      "title": "Операций в минуту",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (module) (rate(fooddiary_module_operations_total{exported_job=~\"$service\",module=~\"$module\"}[$__rate_interval]))",
          "legendFormat": "{{module}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
