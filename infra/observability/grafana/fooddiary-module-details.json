    {
      "id": 6,
      "title": "Операции модуля",
      "type": "table",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Исключения"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Бизнес-ошибки"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (operation) (rate(fooddiary_module_operations_total{exported_job=~\"$service\",module=~\"$module\"}[$__rate_interval]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "(sum by (operation) (rate(fooddiary_module_operations_total{exported_job=~\"$service\",module=~\"$module\",outcome=~\"exception\"}[$__rate_interval])) or on (operation) (0 * sum by (operation) (rate(fooddiary_module_operations_total{exported_job=~\"$service\",module=~\"$module\"}[$__rate_interval])))) / (sum by (operation) (rate(fooddiary_module_operations_total{exported_job=~\"$service\",module=~\"$module\"}[$__rate_interval])) > 0)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "(sum by (operation) (rate(fooddiary_module_operations_total{exported_job=~\"$service\",module=~\"$module\",outcome=~\"failure\"}[$__rate_interval])) or on (operation) (0 * sum by (operation) (rate(fooddiary_module_operations_total{exported_job=~\"$service\",module=~\"$module\"}[$__rate_interval])))) / (sum by (operation) (rate(fooddiary_module_operations_total{exported_job=~\"$service\",module=~\"$module\"}[$__rate_interval])) > 0)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(fooddiary_module_operation_duration_milliseconds_bucket{exported_job=~\"$service\",module=~\"$module\"}[$__rate_interval])))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "sum by (operation) (fooddiary_module_active{exported_job=~\"$service\",module=~\"$module\"})",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Операций/мин",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "operation",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "operation",
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Операций/мин",
              "Value #B": "Исключения",
              "Value #C": "Бизнес-ошибки",
              "Value #D": "p95",
              "Value #E": "Активно",
              "operation": "Операция"
            }
          }
        }
      ]
    },
