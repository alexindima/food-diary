{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(fooddiary_api_requests_total{http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(fooddiary_api_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "title": "API 5xx ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fooddiary_api_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fooddiary_api_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "title": "API latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (fooddiary_outbox_name, fooddiary_outbox_outcome) (increase(fooddiary_outbox_messages_total[15m]))",
          "legendFormat": "{{fooddiary_outbox_name}} / {{fooddiary_outbox_outcome}}",
          "refId": "A"
        }
      ],
      "title": "Outbox outcomes (15m)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "fooddiary_outbox_pending_oldest_age_seconds",
          "legendFormat": "{{fooddiary_outbox_name}}",
          "refId": "A"
        }
      ],
      "title": "Oldest pending outbox message",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "sum by (fooddiary_db_operation, error_type) (increase(fooddiary_db_command_failures_total[15m]))",
          "legendFormat": "{{fooddiary_db_operation}} / {{error_type}}",
          "refId": "A"
        }
      ],
      "title": "Database failures (15m)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
