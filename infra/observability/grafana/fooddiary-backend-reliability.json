{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(fooddiary_api_requests_total{http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(fooddiary_api_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "title": "API 5xx ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fooddiary_api_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fooddiary_api_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "title": "API latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (fooddiary_outbox_name, fooddiary_outbox_outcome) (increase(fooddiary_outbox_messages_total[15m]))",
          "legendFormat": "{{fooddiary_outbox_name}} / {{fooddiary_outbox_outcome}}",
          "refId": "A"
        }
      ],
      "title": "Outbox outcomes (15m)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "fooddiary_outbox_pending_oldest_age_seconds",
          "legendFormat": "{{fooddiary_outbox_name}}",
          "refId": "A"
        }
      ],
      "title": "Oldest pending outbox message",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "sum by (fooddiary_db_operation, error_type) (increase(fooddiary_db_command_failures_total[15m]))",
          "legendFormat": "{{fooddiary_db_operation}} / {{error_type}}",
          "refId": "A"
        }
      ],
      "title": "Database failures (15m)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Client-observed database operation duration, including health checks and non-EF commands. Empty periods indicate no observed traffic.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, exported_job) (rate(db_client_operation_duration_seconds_bucket{exported_job=~\"FoodDiary.Web.Api|FoodDiary.JobManager\"}[5m])))",
          "legendFormat": "{{exported_job}} p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, exported_job) (rate(db_client_operation_duration_seconds_bucket{exported_job=~\"FoodDiary.Web.Api|FoodDiary.JobManager\"}[5m])))",
          "legendFormat": "{{exported_job}} p99",
          "refId": "B"
        },
        {
          "expr": "sum by (exported_job) (rate(db_client_operation_duration_seconds_sum{exported_job=~\"FoodDiary.Web.Api|FoodDiary.JobManager\"}[5m])) / sum by (exported_job) (rate(db_client_operation_duration_seconds_count{exported_job=~\"FoodDiary.Web.Api|FoodDiary.JobManager\"}[5m]))",
          "legendFormat": "{{exported_job}} mean",
          "refId": "C"
        }
      ],
      "title": "PostgreSQL operation latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Completed Npgsql operations per second; compare API and JobManager activity.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (exported_job) (rate(db_client_operation_duration_seconds_count{exported_job=~\"FoodDiary.Web.Api|FoodDiary.JobManager\"}[5m]))",
          "legendFormat": "{{exported_job}}",
          "refId": "A"
        }
      ],
      "title": "PostgreSQL operation rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Pools are aggregated per service. Client pool limits are distinct from PostgreSQL max_connections.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 8,
      "targets": [
        {
          "expr": "sum by (exported_job, db_client_connection_state) (db_client_connection_count{exported_job=~\"FoodDiary.Web.Api|FoodDiary.JobManager\"})",
          "legendFormat": "{{exported_job}} {{db_client_connection_state}}",
          "refId": "A"
        },
        {
          "expr": "sum by (exported_job) (db_client_connection_max{exported_job=~\"FoodDiary.Web.Api|FoodDiary.JobManager\"})",
          "legendFormat": "{{exported_job}} client pool maximum",
          "refId": "B"
        }
      ],
      "title": "Npgsql connections (all pools)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "One pool may be exhausted while another remains idle. Timeouts are failures obtaining a pooled connection.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 9,
      "targets": [
        {
          "expr": "sum by (exported_job) (db_client_connection_npgsql_pending_requests{exported_job=~\"FoodDiary.Web.Api|FoodDiary.JobManager\"})",
          "legendFormat": "{{exported_job}} waiting now",
          "refId": "A"
        },
        {
          "expr": "sum by (exported_job) (increase(db_client_connection_npgsql_timeouts_total{exported_job=~\"FoodDiary.Web.Api|FoodDiary.JobManager\"}[15m]))",
          "legendFormat": "{{exported_job}} timeouts / 15m",
          "refId": "B"
        }
      ],
      "title": "Npgsql pool waits and timeouts",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "New-connection creation duration. No new connections in the window can leave this panel empty.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "id": 10,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, exported_job) (rate(db_client_connection_npgsql_create_time_seconds_bucket{exported_job=~\"FoodDiary.Web.Api|FoodDiary.JobManager\"}[5m])))",
          "legendFormat": "{{exported_job}} p95",
          "refId": "A"
        }
      ],
      "title": "PostgreSQL connection creation p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Driver-level activity and failures, including commands outside EF Core. Complements the existing EF failure panel.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "id": 11,
      "targets": [
        {
          "expr": "sum by (exported_job) (db_client_operation_npgsql_executing{exported_job=~\"FoodDiary.Web.Api|FoodDiary.JobManager\"})",
          "legendFormat": "{{exported_job}} executing now",
          "refId": "A"
        },
        {
          "expr": "sum by (exported_job) (increase(db_client_operation_failed_total{exported_job=~\"FoodDiary.Web.Api|FoodDiary.JobManager\"}[15m]))",
          "legendFormat": "{{exported_job}} failures / 15m",
          "refId": "B"
        }
      ],
      "title": "PostgreSQL active operations and failures",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["fooddiary", "backend", "reliability"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "FoodDiary Backend Reliability",
  "uid": "fooddiary-backend-reliability",
  "version": 2
}
