{
  "id": null,
  "uid": "fooddiary-modules-overview",
  "title": "FoodDiary — Обзор модулей",
  "tags": [
    "fooddiary",
    "modules"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Как читать дашборд",
      "type": "text",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Метрики **команд и запросов mediator**. CPU, память и GC относятся ко всему выбранному процессу. Прямые вызовы сервисов, фоновые задания вне mediator и ответы из HTTP-кэша в таблицу не входят. Модуль появляется после первой операции; отсутствие данных не означает нулевую нагрузку. Нажмите на название модуля для деталей. p95 зависит от состава операций."
      }
    },
    {
      "id": 2,
      "title": "CPU процесса (занятые ядра)",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dotnet_process_cpu_time_seconds_total{exported_job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "CPU cores",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Память процесса (working set)",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(dotnet_process_memory_working_set_bytes{exported_job=~\"$service\"})",
          "legendFormat": "Working set",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Доля времени в GC",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dotnet_gc_pause_time_seconds_total{exported_job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "GC pause",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Модули — текущая нагрузка",
      "type": "table",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Исключения"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Бизнес-ошибки"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Модуль"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Детали модуля",
                    "url": "/d/fooddiary-module-details?var-DS_PROMETHEUS=${DS_PROMETHEUS}&var-service=${service:percentencode}&var-module=${__value.text}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (module) (rate(fooddiary_module_operations_total{exported_job=~\"$service\"}[$__rate_interval]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "(sum by (module) (rate(fooddiary_module_operations_total{exported_job=~\"$service\",outcome=~\"exception\"}[$__rate_interval])) or on (module) (0 * sum by (module) (rate(fooddiary_module_operations_total{exported_job=~\"$service\"}[$__rate_interval])))) / (sum by (module) (rate(fooddiary_module_operations_total{exported_job=~\"$service\"}[$__rate_interval])) > 0)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "(sum by (module) (rate(fooddiary_module_operations_total{exported_job=~\"$service\",outcome=~\"failure\"}[$__rate_interval])) or on (module) (0 * sum by (module) (rate(fooddiary_module_operations_total{exported_job=~\"$service\"}[$__rate_interval])))) / (sum by (module) (rate(fooddiary_module_operations_total{exported_job=~\"$service\"}[$__rate_interval])) > 0)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (le, module) (rate(fooddiary_module_operation_duration_milliseconds_bucket{exported_job=~\"$service\"}[$__rate_interval])))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "sum by (module) (fooddiary_module_active{exported_job=~\"$service\"})",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Операций/мин",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "module",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "module",
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Операций/мин",
              "Value #B": "Исключения",
              "Value #C": "Бизнес-ошибки",
              "Value #D": "p95",
              "Value #E": "Активно",
              "module": "Модуль"
            }
          }
        }
      ]
    },
