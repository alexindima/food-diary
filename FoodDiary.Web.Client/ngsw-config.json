{
    "$schema": "./node_modules/@angular/service-worker/config/schema.json",
    "index": "/index.html",
    "assetGroups": [
        {
            "name": "app",
            "installMode": "prefetch",
            "resources": {
                "files": [
                    "/favicon.ico",
                    "/index.csr.html",
                    "/index.html",
                    "/manifest.webmanifest",
                    "/*.css",
                    "/*.js",
                    "/media/material-icons-subset*.woff2"
                ]
            }
        },
        {
            "name": "lazy-javascript",
            "installMode": "lazy",
            "updateMode": "prefetch",
            "resources": {
                "files": []
            }
        },
        {
            "name": "assets",
            "installMode": "lazy",
            "updateMode": "prefetch",
            "resources": {
                "files": [
                    "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
                ]
            }
        }
    ],
    "navigationUrls": [
        "/**",
        "!/**/*.*",
        "!/**/*__*",
        "!/**/*__*/**",
        "!/explore",
        "!/explore/**",
        "!/ru",
        "!/ru/**",
        "!/food-diary",
        "!/calorie-counter",
        "!/meal-planner",
        "!/macro-tracker",
        "!/intermittent-fasting",
        "!/meal-tracker",
        "!/weight-loss-app",
        "!/dietologist-collaboration",
        "!/nutrition-planner",
        "!/weight-tracker",
        "!/body-progress-tracker",
        "!/shopping-list-for-meal-planning",
        "!/nutrition-tracker",
        "!/food-log",
        "!/protein-tracker",
        "!/meal-prep-planner",
        "!/pricing",
        "!/ai-calorie-tracker",
        "!/about",
        "!/contact",
        "!/guides/how-to-keep-a-food-diary",
        "!/guides/calories-in-homemade-meals",
        "!/privacy-policy"
    ]
}
