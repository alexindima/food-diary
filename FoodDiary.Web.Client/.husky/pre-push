. FoodDiary.Web.Client/.husky/progress.sh

only_deletions=true
saw_ref_update=false
while read -r local_ref local_object_name remote_ref remote_object_name; do
  if [ -z "$local_ref" ]; then
    continue
  fi

  saw_ref_update=true
  if [ "$local_ref" != "(delete)" ] && [ "$local_object_name" != "0000000000000000000000000000000000000000" ]; then
    only_deletions=false
  fi
done

if [ "$saw_ref_update" = true ] && [ "$only_deletions" = true ]; then
  echo "Skipping pre-push verification for ref deletions only."
  exit 0
fi

hook_progress_init "pre-push" 2

HOOK_POWERSHELL=$(command -v pwsh || true)
if [ -z "$HOOK_POWERSHELL" ]; then
  echo "PowerShell 7 (pwsh) is required for Wiki SQLite tooling and .NET artifact cleanup."
  exit 1
fi
PRE_PUSH_ARTIFACTS_PATH=".artifacts/pre-push/$$"
hook_run "Scoped and nested .NET artifact cleanup" "$HOOK_POWERSHELL" -NoLogo -NoProfile -File scripts/Clean-NestedDotnetArtifacts.ps1 -RootArtifactPath "$PRE_PUSH_ARTIFACTS_PATH" || exit 1

cleanup_pre_push_artifacts() {
  if ! "$HOOK_POWERSHELL" -NoLogo -NoProfile -File scripts/Clean-NestedDotnetArtifacts.ps1 -RootArtifactPath "$PRE_PUSH_ARTIFACTS_PATH"; then
    echo "Warning: pre-push checks could not remove generated .NET artifacts." >&2
  fi
}

# Failed and interrupted pushes must not leave several gigabytes of isolated build output behind.
trap cleanup_pre_push_artifacts EXIT

run_frontend_checks() {
  cd FoodDiary.Web.Client || return 1
  npm run check:format:ci || return 1
  npm run lint || return 1
  npm run lint:deps:strict || return 1
  npm run check:depcruise-baseline || return 1
  npm run stylelint || return 1
  npm run audit:design-tokens || return 1
  npm run test:ci:app || return 1
  npm run check:i18n || return 1
}

run_backend_checks() {
  command dotnet build FoodDiary.slnx --artifacts-path "$PRE_PUSH_ARTIFACTS_PATH" || return 1
  command dotnet test FoodDiary.slnx --no-restore --no-build --maxcpucount:1 --artifacts-path "$PRE_PUSH_ARTIFACTS_PATH"
}

hook_step_start "Frontend and backend checks (parallel)"
FRONTEND_LOG="$HOOK_LOG_DIR/02-frontend-checks.log"
BACKEND_LOG="$HOOK_LOG_DIR/02-backend-checks.log"

run_frontend_checks >"$FRONTEND_LOG" 2>&1 &
FRONTEND_PID=$!
run_backend_checks >"$BACKEND_LOG" 2>&1 &
BACKEND_PID=$!

wait "$FRONTEND_PID"
FRONTEND_STATUS=$?
wait "$BACKEND_PID"
BACKEND_STATUS=$?

if [ "$FRONTEND_STATUS" -eq 0 ] && [ "$BACKEND_STATUS" -eq 0 ]; then
  hook_step_done
  printf '    frontend log: %s\n' "$FRONTEND_LOG"
  printf '    backend log: %s\n' "$BACKEND_LOG"
else
  hook_step_fail
  if [ "$FRONTEND_STATUS" -ne 0 ]; then
    printf '    frontend checks failed with exit code %s\n    log: %s\n' "$FRONTEND_STATUS" "$FRONTEND_LOG" >&2
    printf '%s\n' "--- last $HOOK_FAILURE_LOG_LINES frontend log lines ---" >&2
    tail -n "$HOOK_FAILURE_LOG_LINES" "$FRONTEND_LOG" >&2 || true
  fi
  if [ "$BACKEND_STATUS" -ne 0 ]; then
    printf '    backend checks failed with exit code %s\n    log: %s\n' "$BACKEND_STATUS" "$BACKEND_LOG" >&2
    printf '%s\n' "--- last $HOOK_FAILURE_LOG_LINES backend log lines ---" >&2
    tail -n "$HOOK_FAILURE_LOG_LINES" "$BACKEND_LOG" >&2 || true
  fi
  exit 1
fi

hook_progress_done
