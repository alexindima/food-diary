# Check committed content. Full builds, linters and behavioral tests run in CI.
remote_name=${1:-origin}
saw_ref_update=false

while read -r local_ref local_object_name remote_ref remote_object_name; do
  [ -n "$local_ref" ] || continue
  saw_ref_update=true
  if [ "$local_ref" = "(delete)" ] || [ "$local_object_name" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  if [ "$remote_object_name" != "0000000000000000000000000000000000000000" ] && git cat-file -e "$remote_object_name^{commit}" 2>/dev/null; then
    commits=$(git rev-list "$remote_object_name..$local_object_name") || exit 1
  else
    # For new refs or unavailable remote objects, exclude history already known
    # on this remote. Do not recheck the whole repository for a new branch.
    commits=$(git rev-list "$local_object_name" --not --remotes="$remote_name") || exit 1
  fi

  printf 'Checking outgoing whitespace: %s\n' "$local_ref"
  for commit in $commits; do
    # Include root commits and every merge parent; do not read working-tree files.
    git diff-tree --check --root -r -m "$commit" -- || exit 1
  done

  if [ -n "$commits" ] && git cat-file -e "$local_object_name:.llm-wiki/wiki.ps1" 2>/dev/null; then
    command -v pwsh >/dev/null 2>&1 || {
      printf 'Wiki pre-push requires PowerShell 7 (pwsh).\n' >&2
      exit 1
    }
    pwsh -NoLogo -NoProfile -File scripts/ci/Invoke-WikiPrePush.ps1 \
      -RemoteName "$remote_name" -LocalObjectName "$local_object_name" -RemoteObjectName "$remote_object_name" || exit 1
  fi
done

if [ "$saw_ref_update" = false ]; then
  # Manual invocation has no outgoing refs; inspect tracked local changes.
  git diff --check HEAD -- || exit 1
fi

printf 'Pre-push whitespace and applicable Wiki checks passed. Full verification runs in CI.\n'
