. FoodDiary.Web.Client/.husky/progress.sh
hook_progress_init "pre-push" 11

HOOK_POWERSHELL=$(command -v pwsh || command -v powershell.exe || true)
if [ -z "$HOOK_POWERSHELL" ]; then
  echo "PowerShell is required for nested .NET artifact cleanup."
  exit 1
fi
hook_run "Root and nested .NET artifact cleanup" "$HOOK_POWERSHELL" -NoLogo -NoProfile -File scripts/Clean-NestedDotnetArtifacts.ps1 -IncludeRoot || exit 1

cd FoodDiary.Web.Client
hook_run "Frontend formatting" npm run check:format:ci || exit 1
hook_run "Frontend ESLint" npm run lint || exit 1
hook_run "Frontend dependency graph lint" npm run lint:deps:strict || exit 1
hook_run "Dependency graph baseline" npm run check:depcruise-baseline || exit 1
hook_run "Frontend Stylelint" npm run stylelint || exit 1
hook_run "Design token reference audit" npm run audit:design-tokens || exit 1
hook_run "Frontend application tests" npm run test:ci:app || exit 1
hook_run "Frontend i18n consistency" npm run check:i18n || exit 1
cd ..

PRE_PUSH_ARTIFACTS_PATH=.artifacts/pre-push
dotnet() {
  command dotnet "$@" --artifacts-path "$PRE_PUSH_ARTIFACTS_PATH"
}

hook_run "Backend solution build" dotnet build FoodDiary.slnx || exit 1
hook_run "Backend solution tests" dotnet test FoodDiary.slnx --no-restore --no-build --maxcpucount:1 || exit 1

hook_progress_done

if ! "$HOOK_POWERSHELL" -NoLogo -NoProfile -File scripts/Clean-NestedDotnetArtifacts.ps1 -IncludeRoot; then
  echo "Warning: successful pre-push checks could not remove generated .NET artifacts."
fi
