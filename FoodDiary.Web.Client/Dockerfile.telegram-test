FROM node:lts-alpine@sha256:8996bb5821d62a8fd9bb27c1cb07462f3fdce6e47d640c6a881ead0b064ce216 AS build
WORKDIR /app
COPY package*.json ./
COPY scripts/apply-dependency-patches.mjs ./scripts/
RUN npm ci
COPY . .

ARG TELEGRAM_TEST_BOT_USERNAME=
ENV TELEGRAM_TEST_BOT_USERNAME=$TELEGRAM_TEST_BOT_USERNAME
# Modify only the image's build input; the repository production config stays intact.
RUN node --input-type=module <<'NODE'
import fs from 'node:fs';
const username = process.env.TELEGRAM_TEST_BOT_USERNAME;
if (username && !/^[A-Za-z0-9_]{5,32}$/.test(username)) throw new Error('Invalid test bot username');
const path = 'src/environments/environment.prod.ts';
let config = fs.readFileSync(path, 'utf8');
for (const [key, value] of Object.entries({
  telegramBotUsername: username,
  googleClientId: '',
  adminAppUrl: '',
  buildVersion: 'telegram-test',
})) {
  const pattern = new RegExp(`(${key}: )'[^']*'`, 'g');
  if ([...config.matchAll(pattern)].length !== 1) throw new Error(`Missing or ambiguous config key: ${key}`);
  config = config.replace(pattern, `$1'${value}'`);
}
fs.writeFileSync(path, config);
NODE
RUN npx ng build fd-ui-kit && npm run build:prod

FROM nginx:alpine@sha256:785835ea65db4bba6f021acc0f3be91b0fef76a53fe41f8588c6698d2aed0606
COPY --from=build /app/dist/browser/. /usr/share/nginx/html
COPY nginx.telegram-test.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
