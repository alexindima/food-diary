          "quarantinedContextSource": 5,
          "rolledBack": 25,
          "maximum": 60
        }
      },
      "security": {
        "maximumScanCharactersPerFile": 200000,
        "trustZones": [
          {
            "id": "agent-instructions",
            "pattern": "(^|/)AGENTS\\.md$",
            "trust": "trusted-instructions",
            "instructionAuthority": true
          },
          {
            "id": "governed-wiki",
            "pattern": "^\\.llm-wiki/",
            "trust": "governed-context",
            "instructionAuthority": false
          },
          {
            "id": "project-docs",
            "pattern": "^docs/",
            "trust": "reviewed-context",
            "instructionAuthority": false
          }
        ],
        "defaultTrust": "untrusted-data",
        "promptInjectionPatterns": [
          {
            "id": "instruction-override",
            "severity": "critical",
            "pattern": "(?i)(ignore|disregard|forget)\\s+(all\\s+)?(previous|prior|system|developer)\\s+instructions?",
            "replacement": "[QUARANTINED: instruction override]"
          },
          {
            "id": "role-override",
            "severity": "high",
            "pattern": "(?i)(you are now|act as|new system prompt|developer message follows)",
            "replacement": "[QUARANTINED: role override]"
          },
          {
            "id": "secret-exfiltration",
            "severity": "critical",
            "pattern": "(?i)(reveal|print|send|upload|exfiltrate)\\s+.{0,40}(secret|token|password|credential|private key)",
            "replacement": "[QUARANTINED: secret exfiltration]"
          },
          {
            "id": "tool-coercion",
            "severity": "high",
            "pattern": "(?i)(run|execute)\\s+.{0,30}(without\\s+(approval|asking)|bypass\\s+(approval|safety)|disable\\s+safety)",
            "replacement": "[QUARANTINED: tool coercion]"
          }
        ]
      },
      "feedback": {
        "minimumPathSamples": 2,
        "helpfulWeight": 6,
        "noisyWeight": -6,
        "missingWeight": 5,
        "maximumAbsoluteAdjustment": 24,
        "retentionCount": 1000,
        "qualityAdjustments": {
          "reworkDelta": -10,
          "rollbackDelta": -25,
          "regressionDelta": -20,
          "recoveryDelta": 10,
