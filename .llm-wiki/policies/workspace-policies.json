  "export": {
    "pathPattern": "^\\.artifacts/llm-wiki/exports/[^/]+\\.json$",
    "maximumContextItems": 100,
    "defaultContextItems": 50,
    "redaction": {
      "policyId": "whitelist-plus-pattern-redaction-v1",
      "patterns": [
        {
          "id": "private-key",
          "category": "private-key",
          "pattern": "(?s)-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----.*?-----END (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
          "replacementMode": "full"
        },
        {
          "id": "bearer-token",
          "category": "bearer-token",
          "pattern": "(?i)\\bBearer\\s+[A-Za-z0-9._~+/\\-]+=*",
          "replacementMode": "full"
        },
        {
          "id": "jwt",
          "category": "jwt",
          "pattern": "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b",
          "replacementMode": "full"
        },
        {
          "id": "github-token",
          "category": "github-token",
          "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})\\b",
          "replacementMode": "full"
        },
        {
          "id": "aws-access-key",
          "category": "aws-access-key",
          "pattern": "\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b",
          "replacementMode": "full"
        },
        {
          "id": "credential-url",
          "category": "credential-url",
          "pattern": "(?i)\\b([a-z][a-z0-9+.-]*://)[^/\\s:@]+:[^/\\s@]+@",
          "replacementMode": "preserve-group-1"
        },
        {
          "id": "credential-value",
          "category": "credential-value",
          "pattern": "(?i)\\b(password|passwd|secret|api[-_]?key|access[-_]?token|refresh[-_]?token|connection[-_]?string)\\b(\\s*[:=]\\s*[\"']?)(?!\\[REDACTED\\])([^\"'\\s,;}{]+)",
          "replacementMode": "preserve-groups-1-2"
        },
        {
          "id": "email",
          "category": "email",
          "pattern": "\\b[A-Z0-9._%+\\-]+@[A-Z0-9.\\-]+\\.[A-Z]{2,}\\b",
          "replacementMode": "full"
        }
      ]
    }
  },
  "import": {
    "pathPattern": "^\\.artifacts/llm-wiki/exports/[^/]+\\.json$",
    "workspacePattern": "^\\.artifacts/llm-wiki/tasks/[^/.][^/]*$",
    "stagingPrefix": ".task-import-",
    "allowPartialScopeByDefault": false,
    "revalidateAcceptance": true
  }
}
