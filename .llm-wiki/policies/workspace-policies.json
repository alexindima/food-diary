          "minimumCapabilitySamples": 2,
          "coldStartScore": 50,
          "capabilityReliabilityBlendPercent": 65,
          "successWeight": 20,
          "heartbeatWeight": 10,
          "durationWeight": 15,
          "qualityWeight": 15,
