{
  "schemaVersion": 1,
  "description": "Independently authored difficult challenge corpus for SQL context retrieval. Its pre-tuning baseline was 11/40 top-1, 19/40 top-10, and 0.3276 MRR.",
  "diagnosticLimit": 100,
  "thresholds": {
    "minimumTop1Rate": 0.85,
    "minimumTop10Rate": 0.95,
    "minimumMeanReciprocalRank": 0.85
  },
  "switchCriteria": {
    "minimumCaseCount": 40,
    "minimumTop1Rate": 0.95,
    "minimumTop10Rate": 1.0,
    "minimumMeanReciprocalRank": 0.97
  },
  "cases": [
